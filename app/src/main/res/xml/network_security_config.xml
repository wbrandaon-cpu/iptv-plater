<?xml version="1.0" encoding="utf-8"?>
<!-- A maioria dos servidores IPTV usa HTTP puro; sem isso o Android 9+ bloqueia as requisições. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
